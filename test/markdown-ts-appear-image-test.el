(ert-deftest markdown-ts-appear-image-test-wrapped-cells-keep-image-labels ()
  (let ((markdown-ts-appear-table-style 'wrapped))
    (markdown-ts-appear-image-test--buffer
        "| A | B |\n|---|---|\n| x | ![strip](image-slices.svg) |\n"
      (should-not markdown-ts-appear-image--objects)
      (should-not (seq-some (lambda (overlay) (overlay-get overlay 'markdown-ts-image))
