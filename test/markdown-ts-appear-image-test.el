(require 'ert)
(require 'cl-lib)
(defconst markdown-ts-appear-image-test--directory
  (file-name-directory (or load-file-name buffer-file-name)))
(add-to-list 'load-path (file-name-directory
                        (directory-file-name markdown-ts-appear-image-test--directory)))
(require 'markdown-ts-appear)

(defmacro markdown-ts-appear-image-test--buffer (source &rest body)
  "Evaluate BODY in a whole-image Markdown buffer containing SOURCE."
  (declare (indent 1) (debug t))
  `(progn
     (skip-unless (and (treesit-ready-p '(markdown markdown-inline))
                       (image-type-available-p 'svg)))
     (save-window-excursion
       (with-temp-buffer
         (switch-to-buffer (current-buffer))
         (setq default-directory markdown-ts-appear-image-test--directory)
         (insert ,source)
         (markdown-ts-mode)
          (setq-local markdown-ts-inline-images t line-spacing 0)
          (let ((display-p (symbol-function 'display-images-p))
                (font-height (symbol-function 'window-font-height))
                (body-height (symbol-function 'window-body-height))
               (size-function (symbol-function 'image-size)))
           (cl-letf (((symbol-function 'display-images-p)
                      (if noninteractive (lambda (&rest _) t) display-p))
                      ((symbol-function 'window-font-height)
                       (if noninteractive (lambda (&rest _) 20) font-height))
                      ((symbol-function 'window-body-height)
                       (if noninteractive (lambda (&optional _window pixels) (if pixels 400 20))
                         body-height))
                     ((symbol-function 'image-size)
                      (if noninteractive (lambda (&rest _) '(120 . 95)) size-function)))
             (goto-char (point-max))
             (unwind-protect
                 (progn
                   (markdown-ts-appear-mode 1)
                   (markdown-ts-appear-stop)
                   (font-lock-ensure)
                   ,@body)
               (when markdown-ts-appear-mode (markdown-ts-appear-mode -1)))))))))

(defun markdown-ts-appear-image-test--view ()
  "Return the first discovered image view."
  (car (overlay-get (car markdown-ts-appear-image--objects) 'markdown-ts-appear-image--views)))

(ert-deftest markdown-ts-appear-image-test-displays-one-whole-image ()
  (let ((source "before\n\n![strip](image-slices.svg)\n\nafter\n"))
    (markdown-ts-appear-image-test--buffer source
      (should (= 1 (length markdown-ts-appear-image--objects)))
      (let* ((view (markdown-ts-appear-image-test--view))
             (image (markdown-ts-appear-image--view-image view))
             (picture (markdown-ts-appear-image--view-picture view)))
        (should (eq 'image (car (overlay-get picture 'display))))
        (should (eq image (overlay-get picture 'display)))
        (should (equal '(120 . 95) (image-size image t)))
        (should (= 1 (seq-count (lambda (overlay) (eq 'image (car-safe (overlay-get overlay 'display))))
                               (overlays-in (point-min) (point-max)))))
        (should (equal source (buffer-substring-no-properties (point-min) (point-max))))))))

(ert-deftest markdown-ts-appear-image-test-caches-file-and-layout ()
  (let ((read-file (symbol-function 'insert-file-contents-literally)) (reads 0))
    (cl-letf (((symbol-function 'insert-file-contents-literally)
               (lambda (file &rest args)
                 (when (equal (file-name-nondirectory file) "image-slices.svg") (cl-incf reads))
                 (apply read-file file args))))
      (markdown-ts-appear-image-test--buffer "![strip](image-slices.svg)\n\nafter\n"
        (let* ((view (markdown-ts-appear-image-test--view))
               (image (markdown-ts-appear-image--view-image view))
               (picture (markdown-ts-appear-image--view-picture view)))
          (font-lock-flush) (font-lock-ensure)
          (markdown-ts-appear-image--update)
          (should (eq view (markdown-ts-appear-image-test--view)))
          (should (eq image (markdown-ts-appear-image--view-image view)))
          (should (eq picture (markdown-ts-appear-image--view-picture view)))
          (should (= 1 reads)))))))

(ert-deftest markdown-ts-appear-image-test-reveal-restore-and-disable ()
  (markdown-ts-appear-image-test--buffer "![strip](image-slices.svg)\n\nafter\n"
    (let* ((view (markdown-ts-appear-image-test--view))
           (overlay (markdown-ts-appear-image--view-overlay view))
           (image (markdown-ts-appear-image--view-image view)))
      (goto-char (overlay-start (markdown-ts-appear-image--view-picture view)))
      (should (overlay-get overlay 'display))
      (set-window-start (selected-window) (point) t)
      (set-window-vscroll (selected-window) 8 t)
      (markdown-ts-appear-start)
      (should (= 0 (window-vscroll nil t)))
      (should (= (point) (1- (overlay-end (markdown-ts-appear-image--view-owner view)))))
      (should-not (overlay-get overlay 'display))
      (should-not (overlay-get overlay 'before-string))
      (should-not (overlay-get overlay 'after-string))
      (markdown-ts-appear-stop)
      (should (equal (overlay-get overlay 'display) "\n"))
      (should (eq image (markdown-ts-appear-image--view-image view)))
      (markdown-ts-toggle-inline-images)
      (run-hooks 'post-command-hook)
      (should-not markdown-ts-appear-image--objects)
      (should-not (overlay-buffer overlay)))))

